  <vhdl name="elevador">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

ENTITY elevador IS
    PORT (Clock, Reset : IN STD_LOGIC;
    Escolha_andar : IN STD_LOGIC_VECTOR(3 downto 0);
    Subir, Descer : OUT STD_LOGIC; 
    Sensor_andar: OUT STD_LOGIC_VECTOR(3 downto 0));
END elevador;

ARCHITECTURE Behavior OF elevador IS
    TYPE estado_elevador IS (subindo, descendo, parado);
    SIGNAL estado_atual, proximo_estado : estado_elevador;
    SIGNAL s_sensor_andar: std_logic_vector(3 downto 0);
    
BEGIN
    PROCESS (Reset, Clock)
begin
        if Reset = '1' then
            s_sensor_andar &lt;= "0000";      --terreo
            Estado_atual &lt;= parado;     --parado
        END IF;

        if clock'event and clock = '1' then
	    estado_atual &lt;= proximo_estado;    
        END IF;
    END PROCESS;

    PROCESS (Estado_atual, Proximo_estado, sensor_andar, escolha_andar, subir, descer, s_sensor_andar)
        variable int_sensor : integer;
        variable int_escolha: integer;   
begin
    int_sensor := to_integer((unsigned(s_sensor_andar)));
    int_escolha := to_integer((unsigned(escolha_andar)));

    case Estado_atual is

        when Parado =&gt;   
            if int_sensor = int_escolha then --se estiver no andar certo: parado
                Proximo_estado &lt;= parado;
            else
                if int_sensor &lt; int_escolha then    --se estiver no andar inferior Ã  escolha: subindo
                    Proximo_estado &lt;= subindo;
                else       --se estiver no andar superior Ã  escolha: descendo
                    Proximo_estado &lt;= descendo;   
                END IF;
            END IF;

        when Subindo =&gt;

            if int_sensor = int_escolha then
                Proximo_estado &lt;= parado;       --quando chegar, para o elevador
            END IF;

            if s_sensor_andar = "0000" then
                s_sensor_andar &lt;= "0001";
            elsif s_sensor_andar = "1111" then
                Proximo_estado &lt;= parado;
            else
                s_sensor_andar &lt;= std_logic_vector(unsigned(s_sensor_andar) sll 1);      -- desloca Ã  esquerda

            END IF;
        
        when Descendo =&gt;

            if int_sensor = int_escolha then
                Proximo_estado &lt;= parado;       --quando chegar, para o elevador
            END IF;
 
            s_sensor_andar &lt;= std_logic_vector(unsigned(s_sensor_andar) srl 1);      -- desloca Ã  direita
            
        END CASE;

        END PROCESS;
        sensor_andar &lt;= s_sensor_andar;
        -- atribui saÃ­da
        Subir &lt;= '1' when estado_atual = subindo else '0';
        Descer &lt;=  '1' when estado_atual = descendo else '0';
        
END Behavior;</vhdl>
